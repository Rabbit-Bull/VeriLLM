# VeriLLM Environment Configuration Example
# Copy this file to .env in the backend folder and fill in your values when required.
# DO NOT commit real secrets or .env to version control.

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# Database Settings (Required in Phase 11)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=verillm

# Model Generation API Keys (Optional, required in Phase 12 for Mode A)
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face Settings (Optional, for gated models/datasets)
# HF_TOKEN=your_huggingface_token_here

